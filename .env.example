# PLH Rack Monitor - configuration template.
# Copy to .env and edit. The .env file is git-ignored and must never be committed.
# Every value below is optional; the defaults shown are what the app uses.

# ---------------------------------------------------------------- server ----
# Loopback only. Binding to 0.0.0.0 would expose the metrics API to the LAN
# with no authentication, so change this only behind a trusted network.
APP_HOST=127.0.0.1
APP_PORT=8765

# ------------------------------------------------------------ thresholds ----
# Display thresholds for the utilisation donuts (percent).
THRESHOLD_WARNING=70
THRESHOLD_CRITICAL=90

# CPU temperature thresholds are separate and in degrees Celsius. They are not
# the utilisation thresholds: percent and degrees are not comparable scales.
TEMP_WARNING_C=75
TEMP_CRITICAL_C=90

# ------------------------------------------------------- polling cadence ----
# Seconds between samples for each metric family.
INTERVAL_CPU_MEM=1.5
INTERVAL_NET=1.5
INTERVAL_DISK=5
INTERVAL_PROCESSES=10
INTERVAL_TEMP=5
INTERVAL_DISK_HEALTH=60
INTERVAL_PROXMOX=4

# How often a snapshot is pushed to the browser over SSE.
STREAM_PUSH_INTERVAL=1.0

# A collector with no successful run in this many seconds is marked stale.
# A slow loop is judged against its own interval, whichever is longer.
STALE_AFTER_SECONDS=15

# --------------------------------------------------------------- storage ----
# Mounts to monitor. Leave DISK_MOUNTS empty to report every fixed volume.
# List a drive explicitly to keep it on the dashboard as NOT PRESENT while it
# is detached, for example an external SSD:
#   DISK_MOUNTS=C:\,D:\,E:\
DISK_MOUNTS=
DISK_AUTODISCOVER=true

# The volume shown by the DISK donut. Other volumes appear in the detail view.
PRIMARY_DISK_MOUNT=C:\

# Physical drive health through the Windows Storage provider (Get-PhysicalDisk).
DISK_HEALTH_ENABLED=true

# ----------------------------------------------------------- temperature ----
# Windows exposes no CPU temperature to an unprivileged process. Install
# LibreHardwareMonitor and enable either its web server or its WMI provider to
# get a reading; until then the dashboard shows N/A.
TEMP_ENABLED=true
LHM_HTTP_URL=http://127.0.0.1:8085/data.json
LHM_WMI_ENABLED=true
TEMP_PROBE_TIMEOUT_SECONDS=2.0

# After a failed probe, wait this long before trying the sensors again.
SENSOR_BACKOFF_SECONDS=60

# --------------------------------------------------------------- proxmox ----
# Leave HOST empty until a node exists. The Windows dashboard runs without it
# and the node card shows NOT CONFIGURED rather than invented figures.
#
# Create a read-only token on each node (see README):
#   pveum user add monitor@pve
#   pveum aclmod / -user monitor@pve -role PVEAuditor
#   pveum user token add monitor@pve plh --privsep 0
#
# API_NODE is the node name inside Proxmox (pvecm nodes). If it is left as the
# display name and does not match, the node name is discovered automatically.

PROXMOX_NODE_1_NAME=PVE01
PROXMOX_NODE_1_HOST=
PROXMOX_NODE_1_PORT=8006
PROXMOX_NODE_1_API_NODE=
PROXMOX_NODE_1_TOKEN_ID=monitor@pve!plh
PROXMOX_NODE_1_TOKEN_SECRET=
PROXMOX_NODE_1_TIMEOUT_SECONDS=4
# Leave verification on. Point CA_CERT_PATH at the CA that signed the node
# certificate, or at the node certificate itself for a self-signed setup.
PROXMOX_NODE_1_VERIFY_TLS=true
PROXMOX_NODE_1_CA_CERT_PATH=

PROXMOX_NODE_2_NAME=PVE02
PROXMOX_NODE_2_HOST=
PROXMOX_NODE_2_PORT=8006
PROXMOX_NODE_2_API_NODE=
PROXMOX_NODE_2_TOKEN_ID=monitor@pve!plh
PROXMOX_NODE_2_TOKEN_SECRET=
PROXMOX_NODE_2_TIMEOUT_SECONDS=4
PROXMOX_NODE_2_VERIFY_TLS=true
PROXMOX_NODE_2_CA_CERT_PATH=

# A CA bundle used by both nodes unless one sets its own path.
PROXMOX_CA_CERT_PATH=

# ----------------------------------------------------------- development ----
# Fills unconfigured node cards with synthetic values labelled DEV_MOCK, for
# working on the layout without hardware. Never enable this on the wall panel.
DEV_FAKE_PROXMOX=false
